# Overlay into existing mod-azeroth-voices.conf, replacing matching keys.
# Do not replace the whole .conf: many unrelated runtime options must remain.
# The built-in deterministic Q&A and social exchanges are separate from these
# LLM controls. No CPU/GPU calls for those deterministic paths.

AzerothVoices.Enable = 1
AzerothVoices.Personality.Enable = 1
AzerothVoices.Memory.Enable = 1
AzerothVoices.Memory.MaximumPromptItems = 2
AzerothVoices.Memory.MaximumPromptCharacters = 220
AzerothVoices.Sentiment.Enable = 1
AzerothVoices.Sentiment.ConversationMaximumDelta = 1
AzerothVoices.Sentiment.UseInRandom = 0
AzerothVoices.Sentiment.UseInEvents = 0

# Avoid every companion answering at the same time.
AzerothVoices.MaxResponders = 2
AzerothVoices.ResponderFalloff.Enable = 1
AzerothVoices.ResponderFalloff.SecondChance = 20
AzerothVoices.Party.SpeakerRotationPenalty = 75
AzerothVoices.GroupChatter.PlayerFollowupChance = 5
AzerothVoices.GroupChatter.PlayerFollowupCooldownSeconds = 120

# Disable LLM bot-to-bot chatter: local deterministic engine provides nearby
# short exchanges, with hard caps; leave real-player-directed LLM enabled.
AzerothVoices.BotReplyChance.Party = 0
AzerothVoices.BotReplyChance.Say = 0
AiPlayerbot.LLMBotToBotChatChance = 0

# Keep a small amount of context-aware chatter generated by Voices for the
# player's own group, on significant events only.
AzerothVoices.GroupChatter.Enable = 1
AzerothVoices.GroupChatter.IdleChance = 0
AzerothVoices.GroupChatter.DungeonEntryChance = 25
AzerothVoices.GroupChatter.BossPullChance = 10
AzerothVoices.GroupChatter.BossKillChance = 35
AzerothVoices.GroupChatter.WipeChance = 45
AzerothVoices.GroupChatter.QuestAcceptChance = 15
AzerothVoices.GroupChatter.QuestObjectiveChance = 5
AzerothVoices.GroupChatter.QuestCompleteChance = 25
AzerothVoices.GroupChatter.Pacing.MinimumGapSeconds = 45
AzerothVoices.GroupChatter.ConversationMaximumParticipants = 2
AzerothVoices.GroupChatter.ConversationMaximumLines = 3

# Short model context for CPU-only QNAP.
AiPlayerbot.LLMContextLength = 3300
AzerothVoices.WorkerThreads = 1
AzerothVoices.Reply.MaximumCharacters = 140
AzerothVoices.Reply.MaximumLines = 2
AzerothVoices.Typing.Enable = 0
AzerothVoices.Environment.Enable = 1
AzerothVoices.Environment.IncludeEquipment = 1
AzerothVoices.Environment.IncludeBackpack = 1
AzerothVoices.Environment.MaximumItems = 50
AzerothVoices.Snapshot.Enable = 1
AzerothVoices.Snapshot.IncludeQuests = 1
AzerothVoices.Snapshot.MaximumCharacters = 1300
